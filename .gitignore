# For clone-local ignores, put them in .git/info/exclude
# That's effectively a .gitignore that do not get checked in.
#
# For global ignores, use
#  git config --global core.excludesfile ~/.gitignore_global
# and edit ~/.gitignore_global

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
playwright-report/*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local Netlify folder
.netlify
.env

# Test output
test-results

# Temp files when editing PDFs
public/*.qdf

# AI support directories
.serena
janitor
