    "lz-string": "^1.5.0",
    "pdf-lib": "^1.17.1",
    "prop-types": "^15.8.1",
    "react": "^18.0.0",
    "react-device-detect": "^2.2.2",
    "react-dom": "^18.0.0",
    "react-i18next": "^11.16.7",
